# AWS Configuration for Translation Services
# Uses IAM role on AWS (EC2/ECS/Lambda) — no keys needed in production
# For local dev, credentials are picked up from ~/.aws/credentials (AWS CLI)
AWS_REGION=eu-west-1fleetsync
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_CONCURRENCY_LIMIT=3

# Feature Flags
ENABLE_AI_TRANSLATION=true
ENABLE_CONTENT_TRANSLATION=true

# Database Connection (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fleetsync
DB_USER=root
DB_PASSWORD=root_password

# Server
PORT=5000
FRONTEND_URL=http://localhost:8081
JWT_SECRET=your_jwt_secret_here
